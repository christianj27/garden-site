# Graph Link Visibility Fix Patch
# =================================
# The Quartz graph plugin hardcodes link colors that are invisible on dark
# backgrounds:
#   - INITIAL link color: "#333333" (line 461, nearly black)
#   - HOVER link color:   "#555555" (line 353, dark gray)
#
# This patch changes both to use the CSS --gray variable so links respect
# theme colors and are visible in both light and dark mode.
#
# Combined with custom.scss override to brighten dark mode --gray to #999999,
# graph links are now clearly visible at all times.
#
# To reapply after a Quartz plugin update:
#
#   cd ~/quartz-site
#   patch -p1 < patches/graph-link-visibility.patch
#
# Or manually edit:
#   .quartz/plugins/graph/src/components/scripts/graph.inline.ts
#   - Line 353: "#555555" → gray
#   - Line 461: "#333333" → gray

diff --git a/.quartz/plugins/graph/src/components/scripts/graph.inline.ts b/.quartz/plugins/graph/src/components/scripts/graph.inline.ts
--- a/.quartz/plugins/graph/src/components/scripts/graph.inline.ts
+++ b/.quartz/plugins/graph/src/components/scripts/graph.inline.ts
@@ -350,7 +350,7 @@
             alpha = linkData.active ? 1 : 0.2;
           }
           linkData.alpha = alpha;
-          linkData.color = linkData.active ? "#555555" : "#555555";
+          linkData.color = linkData.active ? gray : gray;
         }
       }
@@ -458,7 +458,7 @@
         linkRenderData.push({
           simulationData: link,
           gfx: gfx,
-          color: "#333333",
+          color: gray,
           alpha: 1,
           active: false,
         });
